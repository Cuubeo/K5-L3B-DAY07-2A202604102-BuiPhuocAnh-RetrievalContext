 {
  "query_id": "q08",
  "split": "dev",
  "answerable": true,
  "question": "Why can metrics based on learned representations fail to tell agent-generated programs apart?",
  "status": "answered",
  "answer": "Metrics based on learned representations can fail to distinguish between agent-generated programs because the agent may discover programs that reuse the same frozen representation while applying different downstream self-supervised learning (SSL) procedures. This means that despite potentially large differences in predictive performance, representation-based metrics cannot differentiate between the programs [agentssl-2611.17323v1:p7:para350:5].",
