# Day 7 agent LLM — mọi provider có API tương thích OpenAI /chat/completions + tool calling.
# Ví dụ (chọn MỘT, điền model đang có trong tài khoản của bạn):
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   Cerebras:   LLM_BASE_URL=https://api.cerebras.ai/v1
#   Mistral:    LLM_BASE_URL=https://api.mistral.ai/v1
#   Ollama:     LLM_BASE_URL=http://127.0.0.1:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Giá USD / 1 triệu token để ước tính chi phí (0 nếu miễn phí / chạy local)
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0
# Giãn cách giữa các lần gọi LLM (giây); vd 3 cho gói miễn phí ~20-30 request/phút
LLM_MIN_INTERVAL_S=0

